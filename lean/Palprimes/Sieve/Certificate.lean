  have hloc : ∀ j < 20, ∀ᶠ x : ℝ in Filter.atTop, ∀ p : ℕ, p.Prime → x ^ (aB j) < p →
      (p : ℝ) ≤ x ^ (aB (j + 1)) → fB B x p ≤ max (MB j) 0 * (∏ q ∈ PB B (Zc x), (1 - 1 / (q : ℝ))) / p := by
    intro j hj
    have key : ∀ (m : ℝ), (∀ᶠ x : ℝ in Filter.atTop, ∀ p : ℕ, p.Prime → x ^ (aB j) < p →
        (p : ℝ) ≤ x ^ (aB (j + 1)) → fB B x p ≤ m * (∏ q ∈ PB B (Zc x), (1 - 1 / (q : ℝ))) / p) →
