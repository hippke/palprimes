import KappaOmega2.StatementsK
import KappaOmega2.Items.L03

/-!
# LK07 helper: the fourth moment of the product weight in closed form

For `b = 2M` the integer weight `P(i) = min(i + 1, M, 2M − i)` is `R_0 − R_M − R_{M+1} + R_{2M+1}` (ramps of L03), so
`Φ = P ∗ P` is a combination of the cubic `T(n) = n(n+1)(n+2)/6` at nine shifts. On the five blocks
`[0, M)`, `[M, 2M)`, `{2M}`, `[2M+1, 3M+1)`, `[3M+1, 4M+1)` it is a cubic in the position (expansions generated by
`omega-2/logs/kitems_A/gen_prod_lean.py`, checked there against brute force), and
`Σ_s Φ(s)² = M(M+1)(2M+1)(151M⁴ + 302M³ + 161M² + 10M + 6)/630`.
-/

namespace KappaOmega2

open Finset

/-- Integer product weight `min(i + 1, M, 2M − i)` on `[0, 2M)`. -/
def pU (m i : ℕ) : ℕ := if i < 2 * m then min (min (i + 1) m) (2 * m - i) else 0

lemma pU_arith (m i : ℕ) : pU m i + (i + 1 - m) + (i + 1 - (m + 1)) = (i + 1) + (i + 1 - (2 * m + 1)) := by
  unfold pU
  split_ifs <;> (try simp only [min_def]) <;> (try split_ifs) <;> omega

lemma pU_decomp (m i : ℕ) :
    (pU m i : ℚ) = nR 0 i + (-1) * nR m i + (-1) * nR (m + 1) i + 1 * nR (2 * m + 1) i := by
  have h' : ((pU m i : ℕ) : ℚ) + ((i + 1 - m : ℕ) : ℚ) + ((i + 1 - (m + 1) : ℕ) : ℚ) =
      ((i + 1 : ℕ) : ℚ) + ((i + 1 - (2 * m + 1) : ℕ) : ℚ) := by
    exact_mod_cast pU_arith m i
  unfold nR
  rw [Nat.sub_zero]
  linarith

lemma pConv_lin_left (A B C D : ℕ → ℚ) (c d e : ℚ) (g : ℕ → ℚ) (s : ℕ) :
    nConv (fun i => A i + c * B i + d * C i + e * D i) g s
      = nConv A g s + c * nConv B g s + d * nConv C g s + e * nConv D g s := by
  unfold nConv
  simp only [Finset.mul_sum, ← Finset.sum_add_distrib]
  exact Finset.sum_congr rfl (fun i _ => by ring)

lemma pConv_lin_right (f A B C D : ℕ → ℚ) (c d e : ℚ) (s : ℕ) :
    nConv f (fun i => A i + c * B i + d * C i + e * D i) s
      = nConv f A s + c * nConv f B s + d * nConv f C s + e * nConv f D s := by
  unfold nConv
  simp only [Finset.mul_sum, ← Finset.sum_add_distrib]
  exact Finset.sum_congr rfl (fun i _ => by ring)

/-- `Φ(s) = Σ_i P(i) P(s − i)` as sixteen shifted cubics. -/
def pPhi (m s : ℕ) : ℚ :=
  1 * 1 * nT (s + 1 - 0 - 0)
  + 1 * (-1) * nT (s + 1 - 0 - m)
  + 1 * (-1) * nT (s + 1 - 0 - (m + 1))
  + 1 * 1 * nT (s + 1 - 0 - (2 * m + 1))
  + (-1) * 1 * nT (s + 1 - m - 0)
  + (-1) * (-1) * nT (s + 1 - m - m)
  + (-1) * (-1) * nT (s + 1 - m - (m + 1))
  + (-1) * 1 * nT (s + 1 - m - (2 * m + 1))
  + (-1) * 1 * nT (s + 1 - (m + 1) - 0)
  + (-1) * (-1) * nT (s + 1 - (m + 1) - m)
  + (-1) * (-1) * nT (s + 1 - (m + 1) - (m + 1))
  + (-1) * 1 * nT (s + 1 - (m + 1) - (2 * m + 1))
  + 1 * 1 * nT (s + 1 - (2 * m + 1) - 0)
  + 1 * (-1) * nT (s + 1 - (2 * m + 1) - m)
  + 1 * (-1) * nT (s + 1 - (2 * m + 1) - (m + 1))
  + 1 * 1 * nT (s + 1 - (2 * m + 1) - (2 * m + 1))

lemma pU_conv (m s : ℕ) : ∑ i ∈ range (s + 1), (pU m i : ℚ) * (pU m (s - i) : ℚ) = pPhi m s := by
  have key : nConv (fun i => nR 0 i + (-1) * nR m i + (-1) * nR (m + 1) i + 1 * nR (2 * m + 1) i)
      (fun i => nR 0 i + (-1) * nR m i + (-1) * nR (m + 1) i + 1 * nR (2 * m + 1) i) s = pPhi m s := by
    rw [pConv_lin_left]
    simp only [pConv_lin_right, nConv_R]
    unfold pPhi
    ring
  simp only [pU_decomp]
  exact key

lemma nT_sub_le (n k : ℕ) (h : k ≤ n) : nT (n - k) = nTri ((n : ℚ) - (k : ℚ)) := by
  unfold nT; rw [Nat.cast_sub h]

lemma nT_sub_ge (n k : ℕ) (h : n ≤ k) : nT (n - k) = 0 := by
  rw [Nat.sub_eq_zero_of_le h]; simp [nT, nTri]

def pB0 (m t : ℚ) : ℚ := nTri (t + 1)

def pB1 (m t : ℚ) : ℚ := nTri (m + t + 1) - 2 * nTri (t + 1) - 2 * nTri t

def pB3 (m t : ℚ) : ℚ := nTri (2 * m + 2 + t) - 2 * nTri (m + 2 + t) - 2 * nTri (m + 1 + t) + nTri (t + 2) + 4 * nTri (t + 1) + nTri t

def pB4 (m t : ℚ) : ℚ := nTri (3 * m + 2 + t) - 2 * nTri (2 * m + 2 + t) - 2 * nTri (2 * m + 1 + t) + nTri (m + 2 + t) + 4 * nTri (m + 1 + t) + nTri (m + t) - 2 * nTri (t + 1) - 2 * nTri t

def pB2 (m : ℚ) : ℚ := nTri (2 * m + 1) - 2 * nTri (m + 1) - 2 * nTri m + nTri 1

lemma pPhi_B0 (m x : ℕ) (hx : x < m) : pPhi m (x) = pB0 (m : ℚ) (x : ℚ) := by
  unfold pPhi pB0
  simp (disch := omega) only [Nat.sub_sub, nT_sub_le, nT_sub_ge]
  simp only [nT, nTri]
  push_cast
  ring

lemma pPhi_B1 (m x : ℕ) (hx : x < m) : pPhi m (m + x) = pB1 (m : ℚ) (x : ℚ) := by
  unfold pPhi pB1
  simp (disch := omega) only [Nat.sub_sub, nT_sub_le, nT_sub_ge]
  simp only [nT, nTri]
  push_cast
  ring

lemma pPhi_B3 (m x : ℕ) (hx : x < m) : pPhi m (m + m + 1 + x) = pB3 (m : ℚ) (x : ℚ) := by
  unfold pPhi pB3
  simp (disch := omega) only [Nat.sub_sub, nT_sub_le, nT_sub_ge]
  simp only [nT, nTri]
  push_cast
  ring

lemma pPhi_B4 (m x : ℕ) (hx : x < m) : pPhi m (m + m + 1 + m + x) = pB4 (m : ℚ) (x : ℚ) := by
  unfold pPhi pB4
  simp (disch := omega) only [Nat.sub_sub, nT_sub_le, nT_sub_ge]
  simp only [nT, nTri]
  push_cast
  ring

lemma pPhi_B2 (m : ℕ) : pPhi m (m + m) = pB2 (m : ℚ) := by
  unfold pPhi pB2
  simp (disch := omega) only [Nat.sub_sub, nT_sub_le, nT_sub_ge]
  simp only [nT, nTri]
  push_cast
  ring

lemma pSum_B0 (m : ℕ) : ∑ x ∈ range m, (pB0 (m : ℚ) (x : ℚ)) ^ 2 = (1/140)*(m:ℚ)^1 + (1/8)*(m:ℚ)^2 + (23/72)*(m:ℚ)^3 + (1/3)*(m:ℚ)^4 + (61/360)*(m:ℚ)^5 + (1/24)*(m:ℚ)^6 + (1/252)*(m:ℚ)^7 := by
  have h : ∀ t : ℚ, (pB0 (m : ℚ) t) ^ 2 = ((1)) + ((11/3)) * t ^ 1 + ((193/36)) * t ^ 2 + ((4)) * t ^ 3 + ((29/18)) * t ^ 4 + ((1/3)) * t ^ 5 + ((1/36)) * t ^ 6 := by
    intro t; unfold pB0 nTri; ring
  simp only [h]
  simp only [sum_add_distrib, ← mul_sum, sum_const, card_range, nsmul_eq_mul, nS1, nS2, nS3, nS4, nS5, nS6]
  ring

lemma pSum_B1 (m : ℕ) : ∑ x ∈ range m, (pB1 (m : ℚ) (x : ℚ)) ^ 2 = (-1/420)*(m:ℚ)^1 + (-17/360)*(m:ℚ)^2 + (7/40)*(m:ℚ)^3 + (37/36)*(m:ℚ)^4 + (191/120)*(m:ℚ)^5 + (367/360)*(m:ℚ)^6 + (33/140)*(m:ℚ)^7 := by
  have h : ∀ t : ℚ, (pB1 (m : ℚ) t) ^ 2 = ((1) + (-11/3)*(m:ℚ)^1 + (49/36)*(m:ℚ)^2 + (10/3)*(m:ℚ)^3 + (29/18)*(m:ℚ)^4 + (1/3)*(m:ℚ)^5 + (1/36)*(m:ℚ)^6) + ((5) + (-79/6)*(m:ℚ)^1 + (4/3)*(m:ℚ)^2 + (5)*(m:ℚ)^3 + (5/3)*(m:ℚ)^4 + (1/6)*(m:ℚ)^5) * t ^ 1 + ((41/4) + (-55/3)*(m:ℚ)^1 + (-2/3)*(m:ℚ)^2 + (7/3)*(m:ℚ)^3 + (5/12)*(m:ℚ)^4) * t ^ 2 + ((11) + (-37/3)*(m:ℚ)^1 + (-1)*(m:ℚ)^2 + (1/3)*(m:ℚ)^3) * t ^ 3 + ((13/2) + (-4)*(m:ℚ)^1 + (-1/4)*(m:ℚ)^2) * t ^ 4 + ((2) + (-1/2)*(m:ℚ)^1) * t ^ 5 + ((1/4)) * t ^ 6 := by
    intro t; unfold pB1 nTri; ring
  simp only [h]
  simp only [sum_add_distrib, ← mul_sum, sum_const, card_range, nsmul_eq_mul, nS1, nS2, nS3, nS4, nS5, nS6]
  ring

lemma pSum_B3 (m : ℕ) : ∑ x ∈ range m, (pB3 (m : ℚ) (x : ℚ)) ^ 2 = (-1/420)*(m:ℚ)^1 + (-167/360)*(m:ℚ)^2 + (47/40)*(m:ℚ)^3 + (-2/9)*(m:ℚ)^4 + (-109/120)*(m:ℚ)^5 + (67/360)*(m:ℚ)^6 + (33/140)*(m:ℚ)^7 := by
  have h : ∀ t : ℚ, (pB3 (m : ℚ) t) ^ 2 = ((4) + (-44/3)*(m:ℚ)^1 + (157/9)*(m:ℚ)^2 + (-14/3)*(m:ℚ)^3 + (-35/9)*(m:ℚ)^4 + (4/3)*(m:ℚ)^5 + (4/9)*(m:ℚ)^6) + ((16) + (-136/3)*(m:ℚ)^1 + (112/3)*(m:ℚ)^2 + (-8/3)*(m:ℚ)^3 + (-16/3)*(m:ℚ)^4) * t ^ 1 + ((26) + (-163/3)*(m:ℚ)^1 + (85/3)*(m:ℚ)^2 + (4/3)*(m:ℚ)^3 + (-4/3)*(m:ℚ)^4) * t ^ 2 + ((22) + (-95/3)*(m:ℚ)^1 + (9)*(m:ℚ)^2 + (2/3)*(m:ℚ)^3) * t ^ 3 + ((41/4) + (-9)*(m:ℚ)^1 + (1)*(m:ℚ)^2) * t ^ 4 + ((5/2) + (-1)*(m:ℚ)^1) * t ^ 5 + ((1/4)) * t ^ 6 := by
    intro t; unfold pB3 nTri; ring
  simp only [h]
  simp only [sum_add_distrib, ← mul_sum, sum_const, card_range, nsmul_eq_mul, nS1, nS2, nS3, nS4, nS5, nS6]
  ring

lemma pSum_B4 (m : ℕ) : ∑ x ∈ range m, (pB4 (m : ℚ) (x : ℚ)) ^ 2 = (1/140)*(m:ℚ)^1 + (-1/72)*(m:ℚ)^2 + (-1/72)*(m:ℚ)^3 + (1/36)*(m:ℚ)^4 + (1/360)*(m:ℚ)^5 + (-1/72)*(m:ℚ)^6 + (1/252)*(m:ℚ)^7 := by
  have h : ∀ t : ℚ, (pB4 (m : ℚ) t) ^ 2 = ((1/9)*(m:ℚ)^2 + (-1/3)*(m:ℚ)^3 + (13/36)*(m:ℚ)^4 + (-1/6)*(m:ℚ)^5 + (1/36)*(m:ℚ)^6) + ((-2/9)*(m:ℚ)^1 + (1)*(m:ℚ)^2 + (-13/9)*(m:ℚ)^3 + (5/6)*(m:ℚ)^4 + (-1/6)*(m:ℚ)^5) * t ^ 1 + ((1/9) + (-1)*(m:ℚ)^1 + (13/6)*(m:ℚ)^2 + (-5/3)*(m:ℚ)^3 + (5/12)*(m:ℚ)^4) * t ^ 2 + ((1/3) + (-13/9)*(m:ℚ)^1 + (5/3)*(m:ℚ)^2 + (-5/9)*(m:ℚ)^3) * t ^ 3 + ((13/36) + (-5/6)*(m:ℚ)^1 + (5/12)*(m:ℚ)^2) * t ^ 4 + ((1/6) + (-1/6)*(m:ℚ)^1) * t ^ 5 + ((1/36)) * t ^ 6 := by
    intro t; unfold pB4 nTri; ring
  simp only [h]
  simp only [sum_add_distrib, ← mul_sum, sum_const, card_range, nsmul_eq_mul, nS1, nS2, nS3, nS4, nS5, nS6]
  ring

/-- `Σ_{s ≤ 4M} Φ(s)² = M(M+1)(2M+1)(151M⁴ + 302M³ + 161M² + 10M + 6)/630`. -/
lemma pSumPhi (m : ℕ) : ∑ s ∈ range (4 * m + 1), (pPhi m s) ^ 2 =
    (m : ℚ) * (m + 1) * (2 * m + 1) * (151 * (m : ℚ) ^ 4 + 302 * (m : ℚ) ^ 3 + 161 * (m : ℚ) ^ 2 + 10 * m + 6) / 630 := by
  rw [show 4 * m + 1 = m + m + 1 + m + m by omega, sum_range_add, sum_range_add, sum_range_add, sum_range_add,
    sum_range_one, add_zero]
  have hb0 : ∑ x ∈ range m, (pPhi m x) ^ 2 = ∑ x ∈ range m, (pB0 (m : ℚ) (x : ℚ)) ^ 2 :=
    sum_congr rfl (fun x hx => by rw [pPhi_B0 m x (Finset.mem_range.1 hx)])
  have hb1 : ∑ x ∈ range m, (pPhi m (m + x)) ^ 2 = ∑ x ∈ range m, (pB1 (m : ℚ) (x : ℚ)) ^ 2 :=
    sum_congr rfl (fun x hx => by rw [pPhi_B1 m x (Finset.mem_range.1 hx)])
  have hb3 : ∑ x ∈ range m, (pPhi m (m + m + 1 + x)) ^ 2 = ∑ x ∈ range m, (pB3 (m : ℚ) (x : ℚ)) ^ 2 :=
    sum_congr rfl (fun x hx => by rw [pPhi_B3 m x (Finset.mem_range.1 hx)])
  have hb4 : ∑ x ∈ range m, (pPhi m (m + m + 1 + m + x)) ^ 2 = ∑ x ∈ range m, (pB4 (m : ℚ) (x : ℚ)) ^ 2 :=
    sum_congr rfl (fun x hx => by rw [pPhi_B4 m x (Finset.mem_range.1 hx)])
  rw [hb0, hb1, hb3, hb4, pPhi_B2, pSum_B0, pSum_B1, pSum_B3, pSum_B4]
  unfold pB2 nTri
  ring

end KappaOmega2
