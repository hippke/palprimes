import Omega3.Statements
import Omega3.Items.S10_Chk

/-!
# Item S10: the Σ₂ band certificate at θ = 0.340

Five bands `[1/3, 3917/10000, 9/20, 1271/2500, 5667/10000, 6251/10000]`, step functions on 24 cells
`[A_j/2^20, A_{j+1}/2^20)` with values `m/10^5` (data in `S10_Data.lean`, generated by
`reports/S10_scratch/gen.py`). Each band is checked by the kernel (`bandChk`, Nat/Int arithmetic): log chain,
the allowance on 867 s-boxes (reduced to the left band edge, `S10_Mono.W_ratio`), and the `c_η` bound by
monotone Riemann sums for the `K_jl`. Soundness: `S10.band_ok`.
-/

set_option linter.style.longLine false

open Real

namespace Omega3

open S10

namespace S10

/-- The step function of band `i` (values `ms`). -/
def etaB (ms : List ℤ) : StepFn := stepOfCl (cellsNat (dEdges.headD 0) (ms.headD 0) dEdges.tail ms.tail)

/-- The band data. -/
def BD : BandData where
  xs := [1 / 3, 3917 / 10000, 9 / 20, 1271 / 2500, 5667 / 10000, 6251 / 10000]
  etas := [etaB dMs0, etaB dMs1, etaB dMs2, etaB dMs3, etaB dMs4]
  cs := [1 + 10254 / 1000000, 1 + 8163 / 1000000, 1 + 5962 / 1000000, 1 + 3555 / 1000000, 1 + 1381 / 1000000]

lemma hxr : ((6251 : ℝ) / 10000) ≤ 2 * UU - 1 := by norm_num [UU]

lemma bandI_le (x0 x1 : ℝ) (h0 : 0 < x0) (h1 : 0 < x1) (h2 : x1 < 1) (h3 : x0 < 1) :
    bandI x0 x1 ≤ UU * (x1 / x0 - 1) + (1 - UU) * ((1 - x1) / (1 - x0) - 1) := by
  unfold bandI
  have a := Real.log_le_sub_one_of_pos (div_pos h1 h0)
  have b := Real.log_le_sub_one_of_pos (div_pos (by linarith : (0 : ℝ) < 1 - x1) (by linarith : (0 : ℝ) < 1 - x0))
  have hU : (0 : ℝ) ≤ UU := by norm_num [UU]
  have hU1 : (0 : ℝ) ≤ 1 - UU := by norm_num [UU]
  nlinarith [mul_le_mul_of_nonneg_left a hU, mul_le_mul_of_nonneg_left b hU1]

end S10

theorem itemS10 : ItemS10 := by
  have b0 := band_ok _ _ _ _ _ 1 3 10254 chk0 (by norm_num) (by norm_num) (by norm_num) (by norm_num) (3917 / 10000) (le_trans (by norm_num) hxr)
  have b1 := band_ok _ _ _ _ _ 3917 10000 8163 chk1 (by norm_num) (by norm_num) (by norm_num) (by norm_num) (9 / 20) (le_trans (by norm_num) hxr)
  have b2 := band_ok _ _ _ _ _ 9 20 5962 chk2 (by norm_num) (by norm_num) (by norm_num) (by norm_num) (1271 / 2500) (le_trans (by norm_num) hxr)
  have b3 := band_ok _ _ _ _ _ 1271 2500 3555 chk3 (by norm_num) (by norm_num) (by norm_num) (by norm_num) (5667 / 10000) (le_trans (by norm_num) hxr)
  have b4 := band_ok _ _ _ _ _ 5667 10000 1381 chk4 (by norm_num) (by norm_num) (by norm_num) (by norm_num) (6251 / 10000) hxr
  refine ⟨BD, 1 / (D0 : ℝ), by norm_num [D0], ?_, ?_, ?_, ?_⟩
  · -- BandOK
    refine ⟨rfl, rfl, rfl, ?_, ?_, ?_, ?_, ?_⟩
    · simp only [BD, List.pairwise_cons, List.mem_cons, List.not_mem_nil, or_false, forall_eq_or_imp, forall_eq,
        List.Pairwise.nil, and_true, IsEmpty.forall_iff, implies_true]
      norm_num
    · intro e he
      simp only [BD, List.mem_cons, List.not_mem_nil, or_false] at he
      rcases he with rfl | rfl | rfl | rfl | rfl
      exacts [b0.1, b1.1, b2.1, b3.1, b4.1]
    · intro c hc
      simp only [BD, List.mem_cons, List.not_mem_nil, or_false] at hc
      rcases hc with rfl | rfl | rfl | rfl | rfl <;> norm_num
    · have : BD.xn = 6251 / 10000 := by rfl
      rw [this]; norm_num [UU]
    · have : BD.xn = 6251 / 10000 := by rfl
      rw [this]; norm_num [UU, kSq]
  · -- BandAllow
    intro i hi
    have hl : BD.etas.length = 5 := rfl
    rw [hl] at hi
    interval_cases i
    · intro x t h1 h2 h3 h4
      have e1 : ((BD.xs.getD 0 0 : ℚ) : ℝ) = (1 : ℝ) / 3 := by
        rw [show BD.xs.getD 0 0 = 1 / 3 by rfl]; norm_num
      have e2 : ((BD.xs.getD 1 0 : ℚ) : ℝ) = 3917 / 10000 := by
        rw [show BD.xs.getD 1 0 = 3917 / 10000 by rfl]; norm_num
      rw [e1] at h1; rw [e2] at h2
      exact b0.2.1 x t (by push_cast; exact h1) h2 h3 h4
    · intro x t h1 h2 h3 h4
      have e1 : ((BD.xs.getD 1 0 : ℚ) : ℝ) = 3917 / 10000 := by
        rw [show BD.xs.getD 1 0 = 3917 / 10000 by rfl]; norm_num
      have e2 : ((BD.xs.getD 2 0 : ℚ) : ℝ) = 9 / 20 := by
        rw [show BD.xs.getD 2 0 = 9 / 20 by rfl]; norm_num
      rw [e1] at h1; rw [e2] at h2
      exact b1.2.1 x t (by push_cast; exact h1) h2 h3 h4
    · intro x t h1 h2 h3 h4
      have e1 : ((BD.xs.getD 2 0 : ℚ) : ℝ) = 9 / 20 := by
        rw [show BD.xs.getD 2 0 = 9 / 20 by rfl]; norm_num
      have e2 : ((BD.xs.getD 3 0 : ℚ) : ℝ) = 1271 / 2500 := by
        rw [show BD.xs.getD 3 0 = 1271 / 2500 by rfl]; norm_num
      rw [e1] at h1; rw [e2] at h2
      exact b2.2.1 x t (by push_cast; exact h1) h2 h3 h4
    · intro x t h1 h2 h3 h4
      have e1 : ((BD.xs.getD 3 0 : ℚ) : ℝ) = 1271 / 2500 := by
        rw [show BD.xs.getD 3 0 = 1271 / 2500 by rfl]; norm_num
      have e2 : ((BD.xs.getD 4 0 : ℚ) : ℝ) = 5667 / 10000 := by
        rw [show BD.xs.getD 4 0 = 5667 / 10000 by rfl]; norm_num
      rw [e1] at h1; rw [e2] at h2
      exact b3.2.1 x t (by push_cast; exact h1) h2 h3 h4
    · intro x t h1 h2 h3 h4
      have e1 : ((BD.xs.getD 4 0 : ℚ) : ℝ) = 5667 / 10000 := by
        rw [show BD.xs.getD 4 0 = 5667 / 10000 by rfl]; norm_num
      have e2 : ((BD.xs.getD 5 0 : ℚ) : ℝ) = 6251 / 10000 := by
        rw [show BD.xs.getD 5 0 = 6251 / 10000 by rfl]; norm_num
      rw [e1] at h1; rw [e2] at h2
      exact b4.2.1 x t (by push_cast; exact h1) h2 h3 h4
  · -- c_η ≤ c_i
    intro i hi
    have hl : BD.etas.length = 5 := rfl
    rw [hl] at hi
    interval_cases i
    · rw [show BD.cs.getD 0 1 = 1 + (10254 : ℚ) / 1000000 by rfl]; push_cast; exact b0.2.2
    · rw [show BD.cs.getD 1 1 = 1 + (8163 : ℚ) / 1000000 by rfl]; push_cast; exact b1.2.2
    · rw [show BD.cs.getD 2 1 = 1 + (5962 : ℚ) / 1000000 by rfl]; push_cast; exact b2.2.2
    · rw [show BD.cs.getD 3 1 = 1 + (3555 : ℚ) / 1000000 by rfl]; push_cast; exact b3.2.2
    · rw [show BD.cs.getD 4 1 = 1 + (1381 : ℚ) / 1000000 by rfl]; push_cast; exact b4.2.2
  · -- cost
    unfold bandCost
    have hl : BD.etas.length = 5 := rfl
    rw [hl]
    simp only [Finset.sum_range_succ, Finset.sum_range_zero, zero_add]
    rw [show BD.cs.getD 0 1 = 1 + (10254 : ℚ) / 1000000 by rfl, show BD.cs.getD 1 1 = 1 + (8163 : ℚ) / 1000000 by rfl,
      show BD.cs.getD 2 1 = 1 + (5962 : ℚ) / 1000000 by rfl, show BD.cs.getD 3 1 = 1 + (3555 : ℚ) / 1000000 by rfl,
      show BD.cs.getD 4 1 = 1 + (1381 : ℚ) / 1000000 by rfl,
      show BD.xs.getD 0 0 = 1 / 3 by rfl, show BD.xs.getD 1 0 = 3917 / 10000 by rfl,
      show BD.xs.getD 2 0 = 9 / 20 by rfl, show BD.xs.getD 3 0 = 1271 / 2500 by rfl,
      show BD.xs.getD 4 0 = 5667 / 10000 by rfl, show BD.xs.getD (4 + 1) 0 = 6251 / 10000 by rfl]
    push_cast
    have i0 := bandI_le (1 / 3) (3917 / 10000) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    have i1 := bandI_le (3917 / 10000) (9 / 20) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    have i2 := bandI_le (9 / 20) (1271 / 2500) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    have i3 := bandI_le (1271 / 2500) (5667 / 10000) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    have i4 := bandI_le (5667 / 10000) (6251 / 10000) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    simp only [UU] at i0 i1 i2 i3 i4
    norm_num at i0 i1 i2 i3 i4 ⊢
    nlinarith [i0, i1, i2, i3, i4]

end Omega3
